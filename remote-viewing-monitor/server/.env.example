# Required: Anthropic API key used for vision description + blind grading
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Unsplash access key, used as a fallback image source if Wikimedia
# Commons keeps returning rejected candidates. Get one free at unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Port the server listens on
PORT=8787

# Optional: where to store history.sqlite. Leave unset for local dev (it
# defaults to server/data/). If you deploy somewhere with a persistent disk
# (e.g. a paid Render plan with a Disk mounted at /var/data), point this at
# that mount so history survives restarts/redeploys.
DATA_DIR=

# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL and/or the Android app's origin). Use * only for local testing.
CORS_ORIGIN=*
